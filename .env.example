# Secretos del backend — crear estos keys en Infisical (proyecto uco-parking, env dev).
# Arrancar con: infisical run --env dev -- cmd /c ".\mvnw.cmd spring-boot:run"
#
# Alternativa local sin Infisical: copiar application-local.properties.example
# a application-local.properties y completar DB_PASSWORD.

DB_HOST=localhost
DB_PORT=1434
DB_NAME=ucoparking
DB_USERNAME=sa
DB_PASSWORD=
