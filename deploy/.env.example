# Copia a .env en la VM: cp .env.example .env
# VM recomendada: Google Cloud e2-micro (Ubuntu 22.04) — ver deploy/GOOGLE-CLOUD.md

# IP o dominio publico de la VM Oracle (sin barra final)
PUBLIC_HOST=123.456.789.012

# Front (Auth0 + API)
FRONTEND_PUBLIC_URL=http://123.456.789.012
VITE_AUTH0_DOMAIN=dev-oh62f3hilgh8p2rj.us.auth0.com
VITE_AUTH0_CLIENT_ID=tu-client-id
VITE_AUTH0_AUDIENCE=https://uco-parking-api
# API publica via WAF/Kong (puerto 8000 en prod)
VITE_API_BASE_URL=http://123.456.789.012:8000/uco-parking

# Base de datos
DB_PASSWORD=CambiaEstaPasswordSegura123!

# Auth0 backend
AUTH0_DOMAIN=dev-oh62f3hilgh8p2rj.us.auth0.com
AUTH0_AUDIENCE=https://uco-parking-api
AUTH0_SECURITY_ENABLED=false

# Correo (opcional)
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_FROM_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
