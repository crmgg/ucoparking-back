# Plantilla de secretos para subir a Infisical.
# 1. Copia este archivo a infisical-secrets.env
# 2. Completa DB_PASSWORD
# 3. Ejecuta: .\setup-infisical.ps1

DB_HOST=localhost
DB_PORT=1434
DB_NAME=ucoparking
