# Plantilla de secretos LOCALES (no subir a GitHub).
# Ubicacion del archivo real: uco-parking/infisical-secrets.env  (junto a pom.xml)
#
# Pasos:
# 1. Copia este archivo:  copy infisical-secrets.template.env infisical-secrets.env
# 2. Completa DB_PASSWORD y RESEND_API_KEY
# 3. Pon NOTIFICATION_EMAIL_ENABLED=true cuando quieras enviar correos
#
# Resend: https://resend.com → API Keys → crea una clave re_...
# Prueba sin dominio: NOTIFICATION_FROM_EMAIL=UCO Parking <onboarding@resend.dev>
# (solo envia al correo de tu cuenta Resend)

DB_HOST=localhost
DB_PORT=1434
DB_NAME=ucoparking
DB_USERNAME=sa
DB_PASSWORD=CAMBIAR_AQUI

REDIS_HOST=localhost
REDIS_PORT=6379

# Notification Gateway (Resend recomendado)
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_PROVIDER=resend
NOTIFICATION_FROM_EMAIL=UCO Parking <onboarding@resend.dev>
RESEND_API_KEY=re_CAMBIAR_AQUI

# SMTP Gmail (alternativa: NOTIFICATION_EMAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=tu-correo@gmail.com
# SMTP_PASSWORD=app-password-de-16-caracteres
